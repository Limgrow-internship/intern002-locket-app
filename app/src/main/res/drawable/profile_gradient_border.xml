<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/brand_blue_dark"
                android:endColor="@color/brand_blue_light"
                android:angle="85" />
        </shape>
    </item>

    <item
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"
        android:left="8dp">

        <shape android:shape="oval">
            <solid android:color="@android:color/black" />
        </shape>
    </item>
</layer-list>