<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#3C3C3C" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#9A9A9A"
                android:dashWidth="8dp"
                android:dashGap="6dp" />
        </shape>
    </item>

</layer-list>