<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="50dp" />
            <gradient
                android:startColor="@color/brand_blue_dark"
                android:endColor="@color/brand_blue_light"
                android:angle="0" /> </shape>
    </item>

    <item android:top="2dp" android:right="2dp" android:bottom="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/charcoal_gray" />
            <corners android:radius="48dp" />
        </shape>
    </item>
</layer-list>