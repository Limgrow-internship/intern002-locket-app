    <style name="ShapeAppearance.KeepinWidget.RoundedLarge" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.KeepinWidget.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/blue_light</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">28dp</item>
    </style>
</resources>