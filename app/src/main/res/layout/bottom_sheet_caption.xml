<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="32dp"
    android:background="@drawable/background_bottom_sheet_dark"> <TextView
    android:id="@+id/text_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Caption"
    android:textColor="@color/white"
    android:textStyle="bold"
    android:textSize="18sp"
    android:layout_marginTop="20dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/button_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_x"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="16dp"
        app:tint="#80FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_general"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="General"
        android:textColor="#80FFFFFF"
        android:textSize="14sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/text_title"
        app:layout_constraintStart_toStartOf="parent" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/text_general">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_option_text"
            style="@style/Widget.KeepinWidget.Button.CaptionOption"
            android:text="Text"
            app:icon="@drawable/ic_chat_bubble" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_option_time"
            style="@style/Widget.KeepinWidget.Button.CaptionOption"
            android:text="1:40 PM"
            app:icon="@drawable/ic_clock" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_option_weather"
            style="@style/Widget.KeepinWidget.Button.CaptionOption"
            android:text="Weather"
            app:icon="@drawable/ic_start_caption"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_option_location"
            style="@style/Widget.KeepinWidget.Button.CaptionOption"
            android:text="Location"
            app:icon="@drawable/ic_location_pin" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>