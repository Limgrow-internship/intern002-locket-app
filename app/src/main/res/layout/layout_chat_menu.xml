<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="8dp" 
    app:cardBackgroundColor="#2C2C2E"
    app:cardCornerRadius="14dp"
    app:strokeColor="#5A5A5A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/option_remove_friend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:paddingVertical="8dp"
            android:text="Remove Friend"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:drawableStartCompat="@drawable/ic_remove_friend" />

        <TextView
            android:id="@+id/option_block_friend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:paddingVertical="8dp"
            android:text="Block Friend"
            android:textColor="#FF453A"
            android:textSize="16sp"
            app:drawableStartCompat="@drawable/ic_block_friend" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>